# PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Processing
CONFIDENCE_THRESHOLD=0.7
MAX_PAGES=50
